Cell["Rename variables (model-dependent step) and simplify", "Subsection",
 CellChangeTimes->{{3.945862894470373*^9, 3.945862911518753*^9}, {
  3.945929279696123*^9, 3.945929292722978*^9}, {3.945949883416604*^9, 
  3.945949909892239*^9}, {3.956671512079546*^9, 3.956671521063803*^9}, {
  3.956671757343974*^9, 3.956671763833653*^9}, {3.97066049905634*^9, 
  3.9706605111747513`*^9}},ExpressionUUID->"769aa1f6-c770-432b-b8ba-\
1439b343bd19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceTrigCouplings", "=", 
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{"s\[Gamma]", "->", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"c\[Gamma]", "^", "2"}]}], ")"}], "]"}]}], ",", 
     RowBox[{"c2\[Gamma]", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", 
         RowBox[{"c\[Gamma]", "^", "2"}]}], "-", "1"}], ")"}]}], ",", 
     RowBox[{"s2\[Gamma]", "->", 
      RowBox[{"2", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"c\[Gamma]", "^", "2"}]}], ")"}], "]"}], "*", 
       "c\[Gamma]"}]}], ",", "\n", "\t", 
     RowBox[{"c4\[Gamma]", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c\[Gamma]", "^", "4"}], "-", 
        RowBox[{"6", "*", 
