  3.956671763833653*^9}},ExpressionUUID->"769aa1f6-c770-432b-b8ba-\
1439b343bd19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceTrigCouplings", "=", 
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{"s\[Gamma]", "->", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"c\[Gamma]", "^", "2"}]}], ")"}], "]"}]}], ",", 
     RowBox[{"c2\[Gamma]", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", 
         RowBox[{"c\[Gamma]", "^", "2"}]}], "-", "1"}], ")"}]}], ",", 
     RowBox[{"s2\[Gamma]", "->", 
      RowBox[{"2", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"c\[Gamma]", "^", "2"}]}], ")"}], "]"}], "*", 
       "c\[Gamma]"}]}], ",", "\n", "\t", 
     RowBox[{"c4\[Gamma]", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c\[Gamma]", "^", "4"}], "-", 
        RowBox[{"6", "*", 
         RowBox[{"c\[Gamma]", "^", "2"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"c\[Gamma]", "^", "2"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"c\[Gamma]", "^", "2"}]}], ")"}], "^", "2"}]}], ")"}]}], 
     ",", 
     RowBox[{"s4\[Gamma]", "->", 
      RowBox[{"4", "*", "c\[Gamma]", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"c\[Gamma]", "^", "2"}]}], ")"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{"c\[Gamma]", "^", "2"}]}], "-", "1"}], ")"}]}]}]}], "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.945944857430412*^9, 3.945944906505284*^9}, {
   3.956403534209743*^9, 3.956403570084148*^9}, {3.9566718004896383`*^9, 
   3.9566718063022537`*^9}, {3.956671867783321*^9, 3.956671870243204*^9}, 
   3.956672379006176*^9, {3.956672945655013*^9, 3.956672957752158*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"5b51400c-c37f-4c13-a012-14cc669f32d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"variableReplacement", " ", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m\[CapitalPhi]", "->", "mPhi"}], ",", 
     RowBox[{"MH2", "->", "MHsq"}], ",", " ", 
     RowBox[{"mH2", "->", "mHsq"}], ",", 
     RowBox[{"\[Mu]bar2", "->", "mubarsq"}], ",", 
     RowBox[{"\[Mu]t", "->", "muTilde"}], ",", 
     RowBox[{"\[Lambda]", "->", "lmbd"}], ",", 
     RowBox[{"c\[Gamma]", "->", "cgamma"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"cHqu", "->", "yu"}], ",", 
     RowBox[{"cHqd", "->", "yd"}], ",", " ", 
     RowBox[{"cHle", "->", "ye"}], ",", 
     RowBox[{"cH2", "->", 
      RowBox[{"(", 
       RowBox[{"-", "mHsq"}], ")"}]}], ",", 
     RowBox[{"cB2", "->", "g1"}], ",", 
     RowBox[{"cW2", "->", "g2"}], ",", 
     RowBox[{"cG2", "->", "g3"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.945929552137802*^9, 3.945929606993782*^9}, {
   3.945929767593768*^9, 3.945929795031376*^9}, {3.94592990123687*^9, 
