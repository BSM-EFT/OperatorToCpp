Cell[CellGroupData[{

Cell["One-loop matching", "Section",
 CellChangeTimes->{{3.95796718053684*^9, 
  3.957967184271521*^9}},ExpressionUUID->"b918d898-004c-4bb1-a752-\
feae7b5c7946"],

Cell["\<\
Perform matching up to one-loop level and dimension six in the power counting \
and group result by operators:\
\>", "Text",
 CellChangeTimes->{{3.957969341896715*^9, 3.957969361892521*^9}, {
  3.958065830458713*^9, 
  3.958065846209244*^9}},ExpressionUUID->"29c0461b-23eb-4b6a-8e4c-\
07156951f626"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LEFT1", "=", 
   RowBox[{"Match", "[", 
    RowBox[{"LUV", ",", 
     RowBox[{"EFTOrder", "->", "6"}], ",", 
     RowBox[{"LoopOrder", "->", "1"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.950712351307383*^9, 3.950712371439701*^9}, {
   3.950712452684945*^9, 3.950712454799845*^9}, {3.950758543607189*^9, 
   3.950758547969054*^9}, {3.958058876497031*^9, 3.958058879214*^9}, {
   3.958063287632105*^9, 3.958063290973777*^9}, {3.995011398298602*^9, 
   3.995011408585126*^9}, {3.995016724036482*^9, 3.995016726054079*^9}, {
   3.99501698689927*^9, 3.995016998900299*^9}, {3.995017060862193*^9, 
   3.99501706166098*^9}, {3.9950171274379177`*^9, 3.99501713191597*^9}, 
   3.9950175640494337`*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"99a01c2b-f3ad-479b-8501-db93096ea3b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LEFT1", "//", "NiceForm"}], ";"}]], "Input",
 CellChangeTimes->{{3.99572521026731*^9, 3.995725211098729*^9}, {
  3.995725737265695*^9, 3.995725756577586*^9}, {3.996347938225091*^9, 
  3.9963479454378777`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"31c10faa-bbdf-4f25-8c3d-ef25ba1ad405"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mapping to the Warsaw basis and saving the conditions", "Section",
 CellChangeTimes->{{3.9507108221852837`*^9, 3.9507108225300217`*^9}, {
  3.9957255485141087`*^9, 
  3.995725554846786*^9}},ExpressionUUID->"106f5681-5741-4f13-8bff-\
865d75d2214d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]Warsaw", "=", 
   RowBox[{"LoadModel", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<SMEFT\>\""}], "}"}],
      "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99572559065621*^9, 3.995725600871786*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"8f219fa0-bb54-449a-aac0-e38242c0a5da"],

Cell["\<\
Map the Lagrangian obtained by the matching \[ScriptCapitalL]match onto the \
Warsaw basis Lagrangian \[ScriptCapitalL]Warsaw:\
\>", "Text",
 CellChangeTimes->{{3.9579699108623457`*^9, 3.957969939601561*^9}, {
  3.957970076271394*^9, 
  3.957970076821385*^9}},ExpressionUUID->"a036f39a-f3f7-40a5-a19b-\
25167dfbf748"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MatchingConditions", "=", 
   RowBox[{"EchoTiming", "@", 
    RowBox[{"MapEffectiveCouplings", "[", 
     RowBox[{
     "LEFT1", ",", "\[ScriptCapitalL]Warsaw", ",", "\[IndentingNewLine]", 
      RowBox[{"EOMSimplify", "->", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Ensure", " ", "application", " ", "of", " ", "field", " ", 
        "redefinitions", " ", "for", " ", "the", " ", "mapping", " ", "onto", 
        " ", "the", " ", "Warsaww", " ", 
        RowBox[{"basis", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ReductionIdentities", "->", "EvanescenceFree"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Apply", " ", "Fierz", " ", "identites", " ", "and", " ", "perform", " ",
         "associated", " ", "finite", " ", "renormalization", " ", "shifts", " ",
         "to", " ", "go", " ", "to", " ", "the", " ", "evanescent", " ", 
        "free", " ", 
        OverscriptBox["MS", "_"], " ", 
        RowBox[{"scheme", ".", " ", 
         RowBox[{"[", 
          RowBox[{"See", " ", 
           TemplateBox[{
             RowBox[{"arXiv", ":", "2211.09144"}], {
              URL["https://arxiv.org/abs/2211.09144"], None}, 
             "https://arxiv.org/abs/2211.09144", "HyperlinkActionRecycled", {
             "HyperlinkActive"}, BaseStyle -> {"Hyperlink"}, HyperlinkAction -> 
             "Recycled"},
            "HyperlinkTemplate"], " ", "for", " ", "more", " ", 
           RowBox[{"details", "."}]}], "]"}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ShiftRenCouplings", "->", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Replace", " ", "renormalizable", " ", "UV", " ", "couplings", " ", 
         "by", " ", "effective", " ", "low"}], "-", 
        RowBox[{"energy", " ", 
         RowBox[{"couplings", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"AppendEffectiveCouplingsDefs", "->", "False"}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Adds", " ", "definition", " ", "of", " ", "internally", " ", "defined",
        " ", "couplings", " ", "to", " ", "the", " ", "end", " ", "of", " ", 
       "the", " ", "list", " ", "of", " ", "matching", " ", "conditions"}], 
      " ", "*)"}], "\n", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995725636185319*^9, 3.9957256389364777`*^9}, {
   3.9957258204454107`*^9, 3.995725822322679*^9}, 3.995725880396846*^9, {
   3.995726594804596*^9, 3.995726599156657*^9}, {3.996348094562326*^9, 
   3.996348097586915*^9}, 3.9963482095801983`*^9, {3.996348273053721*^9, 
   3.996348273660097*^9}, {3.996348443096778*^9, 3.99634844408983*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"5be8f653-809d-4804-bac2-f4093fc6be89"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox["\<\"Added new CG \\!\\(\\*RowBox[{\\\"cg1\\\"}]\\) with \
indices \\!\\(\\*RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"fund\\\", \\\"]\\\"}], \\\",\\\", RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"adj\\\", \\\"]\\\"}], \\\",\\\", RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"fund\\\", \\\"]\\\"}]}], \\\"}\\\"}]\\)\"\>",
  StringForm["Added new CG `1` with indices `2`", $CellContext`cg1, {
    $CellContext`SU2L[Matchete`fund], 
    $CellContext`SU2L[Matchete`adj], 
    $CellContext`SU2L[Matchete`fund]}],
  Editable->False]], "Echo",
 CellChangeTimes->{
  3.9963486079015303`*^9},ExpressionUUID->"5cdd61c8-629a-4366-871f-\
cee7d5d4d4a5"],

Cell[BoxData["\<\"The Lagrangian contains terms of lower power than dimension \
4. Defining effective couplings and assuming these terms to be dimension 4. \
Use 'PrintEffectiveCouplings' and 'ReplaceEffectiveCouplings' to recover \
explicit expressions.\"\>"], "Echo",
 CellChangeTimes->{
  3.99634870142034*^9},ExpressionUUID->"adb2c4c4-63b6-452a-a511-9c86efe9e0f6"],

Cell[BoxData["103.607171`"], "EchoTiming",
 CellChangeTimes->{
  3.996348711450555*^9},ExpressionUUID->"3de563f7-4ddb-4e55-8d2e-\
8bb3eab1f248"]
}, Open  ]]
}, Open  ]],

Cell["Remove divergences by renormalization:", "Text",
 CellChangeTimes->{{3.956733477164684*^9, 3.956733509642899*^9}, 
   3.95797007242889*^9},ExpressionUUID->"146d22e7-a687-429c-97e3-\
c2f2a3a0ee4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatchingConditionsFinite", "=", 
   RowBox[{"MatchingConditions", "/.", 
    RowBox[{
     FractionBox["1", "\[Epsilon]"], "->", "0"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.956733459808338*^9, 3.956733490846227*^9}, {
